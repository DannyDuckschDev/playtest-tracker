{
    "compilerOptions": {
      "types": ["node", "jest"],
      "target": "ES2020",
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      //"allowSyntheticDefaultImports": true,
      "moduleResolution": "Node",
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "baseUrl": "./src",
    },
    "include": ["src", "jest.config.ts", "tests"],
    "exclude": ["node_modules", "dist"]
  }
  